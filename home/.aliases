alias ll='ls -alh'
alias ssha='autossh -M 0 -o ServerAliveInterval=30 -o ServerAliveCountMax=2'

alias claw='ssh openclaw@serverito-openclaw'
alias deploy='ssh deploy@serverito-deploy'
alias joelbits='ssh joelbits@example-server'

alias k='kubectl'
alias h='helm'

alias lg='lazygit'

# ── Files ────────────────────────────────────────
alias l='eza --icons=auto --group-directories-first'
alias ll='eza -lah --icons=auto --group-directories-first --git'
alias lt='eza --tree --icons=auto --level=2 --group-directories-first'
alias ltt='eza --tree --icons=auto --group-directories-first'
